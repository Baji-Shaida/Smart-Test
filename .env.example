# SmartTest configuration. Copy to backend/.env (or export in your shell) and adjust.
# LLM provider: "ollama" (default) or "mock" (deterministic canned tests for the sample repo, no GPU needed)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Per LLM call timeout (seconds)
LLM_TIMEOUT_SEC=120
# Per pytest run timeout (seconds)
TEST_TIMEOUT_SEC=30
# Functions below this coverage percent are candidates for generation
COVERAGE_THRESHOLD=60
# Default number of functions to process in Phase B
MAX_FUNCTIONS_DEFAULT=10
# Upload size cap (MB) and max number of files inside a zip
MAX_UPLOAD_MB=50
MAX_ZIP_FILES=5000
# Where job folders live (relative to the backend working directory)
WORKSPACE_DIR=./data/jobs
# Comma separated list of allowed browser origins (Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
